+    val activeProgram = document?.program
+    val selectedFeature = if (selection.kind == V23NodeKind.FEATURE) {
+        activeProgram?.features?.firstOrNull { it.id == selection.id }
+    } else null
+    val selectedSketch = if (selection.kind == V23NodeKind.SKETCH) {
+        activeProgram?.sketches?.firstOrNull { it.id == selection.id }
+    } else null
+    val selectedPlane = if (selection.kind == V23NodeKind.PLANE) {
+        activeProgram?.planes?.firstOrNull { it.id == selection.id }
+    } else null
+    val activeSketch = activeProgram?.activeSketch()
+    val baseFeature = activeProgram?.features?.firstOrNull()
+    val baseSketch = activeProgram?.sketch(baseFeature?.sketchId)
