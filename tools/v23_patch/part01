+        mutableStateOf(preferences.getBoolean("right_visible", true))
+    }
+    var drawerVisible by rememberSaveable {
+        mutableStateOf(preferences.getBoolean("drawer_visible", true))
+    }
+    var drawerTab by rememberSaveable {
+        mutableStateOf(
+            runCatching {
+                V23DrawerTab.valueOf(
